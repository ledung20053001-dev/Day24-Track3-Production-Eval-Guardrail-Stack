# Choose one provider: openai or gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Fill only the key for the selected provider
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Gemini example:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-key

# Optional
MOCK_MODE=false

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=hf_...
